{
  "name": "kopy-language",
  "displayName": "KoPy Language Support",
  "description": "KoPy Core를 단일 원본으로 사용해 VS Code에서 KoPy를 작성·진단·실행하는 공식 개발 확장입니다.",
  "version": "0.3.0",
  "publisher": "kopy-project",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "keywords": ["KoPy", "Python", "Korean", "한국어", "코파이"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:kopy", "onCommand:kopy.runFile", "onCommand:kopy.refreshCore"],
  "contributes": {
    "languages": [
      {
        "id": "kopy",
        "aliases": ["KoPy", "kopy"],
        "extensions": [".kpy"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kopy",
        "scopeName": "source.kopy",
        "path": "./syntaxes/kopy.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kopy.runFile",
        "title": "KoPy: 현재 파일 실행",
        "icon": "$(play)"
      },
      {
        "command": "kopy.refreshCore",
        "title": "KoPy: Core 정보 새로고침"
      },
      {
        "command": "kopy.toggleSpelling",
        "title": "KoPy: 스펠링 힌트 켜기/끄기"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kopy.runFile",
          "when": "editorLangId == kopy",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kopy.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == kopy"
      }
    ],
    "configuration": {
      "title": "KoPy",
      "properties": {
        "kopy.executablePath": {
          "type": "string",
          "default": "kopy",
          "description": "KoPy Core 실행 명령 또는 실행 파일 경로입니다. 개발 환경에서는 editable install로 등록된 PATH의 'kopy' 명령을 사용합니다."
        },
        "kopy.spelling.enabled": {
          "type": "boolean",
          "default": true,
          "description": "KoPy Core가 반환한 영문 Python 스펠링 진단을 표시합니다."
        },
        "kopy.inlinePythonHints": {
          "type": "boolean",
          "default": true,
          "description": "KoPy Core의 공식 단어 등록부를 사용해 한글 토큰의 실제 Python 표현을 Hover로 표시합니다."
        }
      }
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package --no-dependencies"
  }
}
