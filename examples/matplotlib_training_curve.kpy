임포트 맷플롯립.pyplot 애즈 plt

에폭 = [1, 2, 3, 4, 5]
학습손실 = [1.0, 0.73, 0.52, 0.41, 0.33]
검증손실 = [1.1, 0.82, 0.61, 0.55, 0.57]

피겨, 축 = plt.서브플롯츠()
축.플롯(에폭, 학습손실, marker="o", label="train")
축.플롯(에폭, 검증손실, marker="o", label="validation")
축.셋타이틀("Training curve")
축.셋엑스라벨("Epoch")
축.셋와이라벨("Loss")
축.그리드(True)
축.레전드()
피겨.세이브피그("training_curve.png")
plt.클로즈(피겨)
