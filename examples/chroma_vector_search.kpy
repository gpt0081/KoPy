임포트 크로마 애즈 chroma

client = chroma.클라이언트()
collection = client.크리에이트컬렉션(
    name="docs",
    embedding_function=None,
)

임베딩즈 = [
    [1.0, 0.0],
    [0.0, 1.0],
]

다큐먼츠 = [
    "alpha document",
    "beta document",
]

collection.애드(
    ids=["alpha", "beta"],
    embeddings=임베딩즈,
    documents=다큐먼츠,
)

query_embeddings = [[0.99, 0.01]]
리절트 = collection.쿼리(
    query_embeddings=query_embeddings,
    n_results=2,
)

프린트(리절트["ids"])
프린트(리절트["documents"])
