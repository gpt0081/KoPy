임포트 랜스디비 애즈 ldb

# connect/create_table/search 같은 표현은 실제 Python/LanceDB 코드를 익히도록 원문을 유지합니다.
db = ldb.connect("./lancedb-demo")

documents = [
    {"id": "alpha", "vector": [1.0, 0.0], "text": "KoPy teaches Python through transliteration."},
    {"id": "beta", "vector": [0.0, 1.0], "text": "LanceDB stores and searches vectors locally."},
]

table = db.create_table(
    "docs",
    data=documents,
    mode="overwrite",
)

query = [0.05, 0.95]
results = table.search(query).limit(2).to_list()

프린트(results)
