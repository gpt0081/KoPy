임포트 센텐스트랜스포머스 애즈 st

# 실제 교육 자료에서는 model/sentences/embeddings 같은 Python 관례를 그대로 남긴다.
model = st.센텐스트랜스포머("sentence-transformers/all-MiniLM-L6-v2")

sentences = [
    "KoPy helps learners read Python code.",
    "Sentence embeddings map text into vectors.",
    "Rubber compounds contain polymers and additives.",
]

embeddings = model.인코드(sentences, convert_to_tensor=True)
query_embeddings = model.인코드(["How can I learn Python?"], convert_to_tensor=True)

hits = st.유틸.시맨틱서치(
    query_embeddings,
    embeddings,
    top_k=2,
)

프린트(hits)
