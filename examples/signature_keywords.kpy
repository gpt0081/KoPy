# KoPy 0.5.50 공통 시그니처 키워드 예제
# 숫자와 문자열 값은 그대로 유지되고, 식별자 이름만 음역합니다.

설정 = build(
    네임="docs",
    임베딩_펑션=논,
)

엑스_트레인, 엑스_테스트, 와이_트레인, 와이_테스트 = split(
    엑스,
    와이,
    테스트_사이즈=0.2,
    랜덤_스테이트=42,
)

모델 = train(
    맥스_이터=200,
    디타입="float32",
)

# top_k는 검색/ML에서 널리 쓰이는 표준 표기라 교육 예외로 원문을 유지합니다.
리절츠 = 리트리버.리트리브(쿼리_토큰즈, top_k=5)
