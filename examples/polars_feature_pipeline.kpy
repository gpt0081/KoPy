임포트 폴라스 애즈 pl

# 실제 Python 데이터 처리 관례를 함께 익히도록 변수명은 일부 영어 표기를 유지한다.
df = pl.데이터프레임({
    "label": ["A", "A", "B", "B"],
    "x": [1, 2, 3, 4],
})

features = df.위드컬럼즈(
    (pl.컬("x") * 2).에일리어스("x2")
)

summary = (
    features
    .필터(pl.컬("x2") >= 4)
    .그룹바이("label")
    .어그(pl.컬("x2").미인().에일리어스("x2_mean"))
    .소트("label")
)

프린트(summary)
